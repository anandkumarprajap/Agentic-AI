import asyncio
import warnings
from fastmcp import FastMCP
from langchain_ollama import ChatOllama
from langchain.mcp import MCPAdapter
from langgraph.prebuilt import create_react_agent

# Silence the beta/deprecation warnings to keep your console logs clean
warnings.filterwarnings("ignore", category=UserWarning)

# 1. Define our Local Tool Server using FastMCP
mcp_server = FastMCP("Local Math Server")

@mcp_server.tool()
def multiply_numbers(x: float, y: float) -> float:
    """Multiply two numbers together."""
    return x * y

async def main():
    print("🤖 Initializing local Ollama model (Gemma 4)...")
    # 2. Pointing directly to your local gemma4:12b model!
    # Standardized sampling config gives the best agentic behavior
    llm = ChatOllama(
        model="gemma4:12b", 
        temperature=1.0, 
        top_p=0.95,
        top_k=64
    )

    print("🔌 Connecting LangChain to the FastMCP server...")
    async with MCPAdapter(mcp_server) as adapter:
        tools = await adapter.list_tools()
        
        print("🕸️ Building the LangGraph agent architecture...")
        # 3. Create a clean ReAct agent graph
        agent = create_react_agent(llm, tools=tools)
        
        # 4. Execute a query requiring our local tool
        query = {"messages": [{"role": "user", "content": "What is 12.5 multiplied by 8?"}]}
        
        print("🚀 Running agent workflow...")
        response = await agent.ainvoke(query)
        
        # Output the final answer generated by the agent
        print("\n✨ Agent Response:")
        print(response["messages"][-1].content)

if __name__ == "__main__":
    asyncio.run(main())
